{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "Mode": "Oidc",
    "LocalEnabled": false,
    "Issuer": "support360-local",
    "Audience": "support360-api",
    "SigningKey": "",
    "TokenLifetimeMinutes": 60,
    "OidcAuthority": "",
    "OidcAudience": "support360-api",
    "TenantClaim": "tenant_id",
    "OidcRoleClaims": [ "role", "roles" ],
    "OidcRoleMappings": {},
    "OidcNameClaim": "name",
    "OidcEmailClaim": "email",
    "OidcSubjectClaim": "sub",
    "OidcRequireRoleClaim": true
  },
  "AgentPlatform": {
    "HeartbeatIntervalSeconds": 30,
    "TelemetryIntervalSeconds": 60,
    "OfflineAfterSeconds": 90,
    "MaxMetricsPerBatch": 500,
    "MaxJobEventsPerBatch": 200,
    "MaxMetricAgeHours": 24,
    "MaxClockSkewMinutes": 5,
    "EnrollmentLifetimeMinutes": 15,
    "AgentCredentialLifetimeDays": 0
  },
  "Retention": {
    "TelemetryDays": 7,
    "AuditDays": 365,
    "ResolvedAlertDays": 90,
    "ApplicationCheckResultDays": 30,
    "UsageDays": 400,
    "RunIntervalMinutes": 60
  },
  "Deployment": {
    "ExecutionEnabled": false,
    "ManifestSigningPrivateKey": null,
    "ManifestSigningPublicKey": null,
    "ManifestSigningKeyId": "support360-deployment-v1",
    "ManifestLifetimeMinutes": 30
  },
  "Seed": {
    "Enabled": false,
    "TenantName": "Demo Operations",
    "TenantSlug": "demo",
    "AdminEmail": "admin@support360.local",
    "AdminDisplayName": "Support360 Administrator",
    "AdminPassword": "",
    "IsDemoTenant": true
  },
  "BackgroundWorkers": {
    "Enabled": true
  },
  "RateLimits": {
    "EnrollmentPermitLimit": 10,
    "EnrollmentWindowMinutes": 5,
    "LoginPermitLimit": 10,
    "LoginWindowMinutes": 1,
    "AgentPermitLimit": 240,
    "AgentWindowMinutes": 1,
    "UserPermitLimit": 600,
    "UserWindowMinutes": 1
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Http": {
    "UseHttpsRedirection": false
  },
  "ReverseProxy": {
    "Enabled": false
  }
}
