{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "Provider": "Postgres"
  },
  "Auth": {
    "Mode": "Oidc",
    "LocalEnabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "Deployment": {
    "ExecutionEnabled": false
  },
  "Http": {
    "UseHttpsRedirection": false
  },
  "ReverseProxy": {
    "Enabled": true
  }
}
