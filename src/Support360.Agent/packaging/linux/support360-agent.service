[Unit]
Description=Support360 monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=support360
Group=support360
EnvironmentFile=/etc/support360/agent.env
ExecStart=/usr/local/bin/support360-agent run
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/support360 /var/cache/support360
LockPersonality=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
